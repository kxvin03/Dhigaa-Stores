generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  name               String
  phone              String?
  role               String    @default("CUSTOMER") // CUSTOMER, ADMIN, STAFF
  mustChangePassword Boolean   @default(false)
  loyaltyTier        String    @default("SILVER") // SILVER, GOLD, PLATINUM
  loyaltyPoints      Int       @default(100)
  birthDate          String?
  anniversaryDate    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  addresses          Address[]
  orders             Order[]
  reviews            Review[]
  wishlists          Wishlist[]
  cart               Cart?
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  addressLine  String
  locality     String?
  city         String
  state        String
  pincode      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Category {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  image        String?
  displayOrder Int       @default(0)
  parentId     String?
  products     Product[]
  createdAt    DateTime  @default(now())
}

model Product {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  sku              String         @unique
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  price            Float
  compareAtPrice   Float?
  costPrice        Float?
  stock            Int            @default(10)
  fabric           String // e.g. "Pure Kanchipuram Silk", "Chettinad Cotton", "Tussar Silk"
  zariType         String? // e.g. "Pure Gold Zari", "Tested Silver Zari", "Antique Copper Zari"
  borderType       String? // e.g. "Korvai Temple Border", "Contrast Rich Zari", "Contrast Pallu"
  palluDetails     String? // e.g. "Intricate Peacock & Floral Brocade"
  weaveType        String? // e.g. "Handloom Double Warp"
  occasion         String? // e.g. "Bridal, Wedding, Festive, Pongal"
  color            String // e.g. "Crimson Red", "Royal Teal", "Mustard Yellow"
  colorHex         String? // e.g. "#8B1E2E"
  isFeatured       Boolean        @default(false)
  isBestSeller     Boolean        @default(false)
  isFestivalSpecial Boolean       @default(false)
  isPublished      Boolean        @default(true)
  rating           Float          @default(4.9)
  reviewCount      Int            @default(12)
  description      String
  careInstructions String?
  deliveryEstimate String?        @default("Same-day in Erode, 3-5 days across India")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  images           Media[]
  variants         Variant[]
  reviews          Review[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  wishlists        Wishlist[]
}

model Variant {
  id           String     @id @default(uuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  color        String?
  colorHex     String?
  size         String?    // e.g. "Unstitched Saree with Blouse Piece", "Blouse 36", "Blouse 38"
  sku          String     @unique
  stock        Int        @default(5)
  priceDelta   Float      @default(0.0)
  imageUrl     String?
  cartItems    CartItem[]
}

model Media {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String?
  mediaType    String   @default("IMAGE") // IMAGE, VIDEO, MODEL3D
  displayOrder Int      @default(0)
}

model AddOn {
  id          String   @id @default(uuid())
  name        String   // "Custom Blouse Stitching", "Fall & Pico Hemming", "Matching Cotton Petticoat", "Luxury Gift Wrap"
  code        String   @unique
  price       Float
  description String?
  isActive    Boolean  @default(true)
}

model Cart {
  id             String     @id @default(uuid())
  userId         String?    @unique
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId String?    @unique
  items          CartItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity   Int      @default(1)
  addOnsJson String?  // JSON serialized add-on selections
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id                 String            @id @default(uuid())
  orderNumber        String            @unique
  userId             String?
  user               User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName       String
  customerEmail      String
  customerPhone      String
  status             String            @default("PLACED") // PLACED, CONFIRMED, STITCHING, DISPATCHED, DELIVERED, CANCELLED, RETURNED
  paymentStatus      String            @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paymentMethod      String            @default("RAZORPAY") // RAZORPAY, COD, STORE_PICKUP
  totalAmount        Float
  subtotal           Float
  discountAmount     Float             @default(0.0)
  shippingAmount     Float             @default(0.0)
  taxGst             Float             @default(0.0)
  couponCode         String?
  shippingAddressJson String           // JSON of address
  deliveryType       String            @default("STANDARD") // STANDARD, ERODE_SAMEDAY, STORE_PICKUP
  trackingNumber     String?
  courierPartner     String?
  estimatedDelivery  String?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  orderItems         OrderItem[]
  payment            Payment?
  stitchingRequests  StitchingRequest[]
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  variantId    String?
  productName  String
  variantTitle String?
  price        Float
  quantity     Int
  addOnsJson   String?  // JSON string
  imageUrl     String?
}

model Payment {
  id                 String   @id @default(uuid())
  orderId            String   @unique
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  razorpayOrderId    String?  @unique
  razorpayPaymentId  String?  @unique
  razorpaySignature  String?
  amount             Float
  status             String   @default("CREATED") // CREATED, CAPTURED, FAILED, REFUNDED
  method             String?  // upi, card, netbanking, cod
  refundId           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model StitchingRequest {
  id                  String   @id @default(uuid())
  orderId             String?
  order               Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerName        String
  phone               String
  email               String
  garmentType         String   @default("BLOUSE") // BLOUSE, SALWAR, PATTU_PAVADAI
  neckDesign          String?  // "Boat Neck", "Deep U", "Potli Button High Neck", etc.
  sleeveType          String?  // "Elbow Length Maggam", "Sleeveless", "Cap Sleeve"
  bust                Float?
  waist               Float?
  blouseLength        Float?
  shoulder            Float?
  frontNeck           Float?
  backNeck            Float?
  sleeveLength        Float?
  armHole             Float?
  notes               String?
  referenceImageUrl   String?
  status              String   @default("PENDING") // PENDING, MEASUREMENTS_CONFIRMED, STITCHING, READY, DISPATCHED
  assignedTailor      String?
  priceEstimate       Float    @default(999.0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Booking {
  id        String   @id @default(uuid())
  type      String   // BRIDAL_CONSULTATION, VIDEO_SHOPPING, ERODE_HOME_TRIAL, STORE_VISIT
  name      String
  phone     String
  email     String
  date      String   // YYYY-MM-DD
  timeSlot  String   // e.g. "11:00 AM - 12:00 PM"
  notes     String?
  address   String?  // Required for Erode Home Trial
  status    String   @default("CONFIRMED") // CONFIRMED, COMPLETED, CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountType   String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  value          Float
  minOrderAmount Float     @default(0.0)
  maxDiscount    Float?
  expiresAt      DateTime?
  usageLimit     Int       @default(1000)
  usedCount      Int       @default(0)
  isActive       Boolean   @default(true)
}

model GiftCard {
  id             String   @id @default(uuid())
  code           String   @unique
  initialBalance Float
  currentBalance Float
  recipientEmail String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Review {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName        String
  rating          Int      @default(5)
  title           String?
  comment         String
  imagesJson      String?  // JSON array of customer photos
  isVerifiedBuyer Boolean  @default(true)
  isApproved      Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model ThemeSetting {
  id             String   @id @default("default")
  primaryColor   String   @default("#6A5446") // Warm taupe brown
  secondaryColor String   @default("#B8924A") // Antique gold accent
  creamColor     String   @default("#F5EEE2") // Heritage silk cream
  espressoColor  String   @default("#2B211C") // Dark mode background
  blushColor     String   @default("#E8D5C8") // Soft highlight
  fontHeading    String   @default("Playfair Display")
  fontBody       String   @default("Inter")
  borderRadius   String   @default("0.75rem")
  enable3DHero   Boolean  @default(true)
  heroIntensity  Float    @default(1.0)
  logoUrl        String   @default("/assets/logo.png")
  logoLightUrl   String   @default("/assets/logo-light.png")
  logoDarkUrl    String   @default("/assets/logo-dark.png")
  updatedAt      DateTime @updatedAt
}

model Page {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  contentJson String?  // Flexible section builder JSON
  metaTitle   String?
  metaDesc    String?
  updatedAt   DateTime @updatedAt
}

model Section {
  id           String   @id @default(uuid())
  pageSlug     String   @default("home")
  sectionType  String   // HERO, BANNER_STRIP, BEST_SELLERS, WEAVING_STORY, REVIEWS, INSTAGRAM
  title        String
  subtitle     String?
  contentJson  String?  // Serialized configuration
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
}

model Banner {
  id           String   @id @default(uuid())
  title        String
  subtitle     String?
  badge        String?  // e.g. "Pongal Festive Special", "Bridal Edit"
  imageUrl     String
  linkUrl      String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
}

model BlogPost {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  imageUrl    String
  author      String   @default("Dhigaa Editorial")
  tags        String   @default("Silk, Heritage, Erode Weavers")
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Enquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("NEW") // NEW, CONTACTED, RESOLVED
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  staffName String
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}

model StoreSetting {
  id          String @id @default(uuid())
  key         String @unique
  value       String
  description String?
}

